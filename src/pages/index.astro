---
/**
 * 首页:一句话介绍 + 项目列表(按 order 倒序)。
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
---

<Base>
	<section class="intro">
		<h1>Peng Wang</h1>
		<p>Full stack developer in Ottawa, ON.</p>
	</section>

	<section id="projects">
		<h2>Projects</h2>
		<ul class="list">
			{
				projects.map((p) => (
					<li>
						<a class="name" href={`/projects/${p.id}/`}>{p.data.title}</a>
						<div class="meta">{p.data.role} | {p.data.org} | {p.data.dates}</div>
						<p>{p.data.summary}</p>
						<div class="stack">{p.data.stack.join(', ')}</div>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.intro h1 {
		margin: 0 0 4px;
		font-size: 32px;
	}
	.intro p {
		margin: 0 0 32px;
		color: var(--text2);
	}
	h2 {
		font-size: 20px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 8px;
	}
	.list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.list li {
		padding: 16px 0;
		border-bottom: 1px solid var(--line);
	}
	.name {
		font-weight: 600;
		font-size: 17px;
	}
	.meta,
	.stack {
		color: var(--text2);
		font-size: 14px;
	}
	.list p {
		margin: 6px 0;
	}
</style>
