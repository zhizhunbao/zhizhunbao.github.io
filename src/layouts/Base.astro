---
/**
 * 全站外壳:head、页眉、正文、页脚。视觉方向 B「Console」:浅灰绿底、翠绿强调色、等宽标签。
 */
interface Props {
	/** 页面标题(不含站名)。 */
	title?: string;
	/** 页面描述(meta description)。 */
	description?: string;
}

const SITE_NAME = 'Peng Wang';
const {
	title,
	description = 'Peng Wang: Cloud, DevOps, Data Engineering and Full Stack in Ottawa. 10 years building software, 7 of them running a big data platform.',
} = Astro.props;
let pageTitle = `${SITE_NAME} | Cloud, DevOps & Data`;
if (title) {
	pageTitle = `${title} | ${SITE_NAME}`;
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f7f5" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="top rail">
			<a class="brand" href="/">Peng Wang</a>
			<nav>
				<a href="/#work">Work</a>
				<a href="/#experience">Experience</a>
				<a href="/#contact">Contact</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="rail"><div class="foot">© {new Date().getFullYear()} {SITE_NAME}</div></footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f4f7f5;
		--card: #ffffff;
		--text: #10201a;
		--text2: #56665f;
		--line: #dfe7e2;
		--line2: #c9d6cf;
		--accent: #047857;
		--tag: #e6f4ee;
		--tagtext: #065f46;
		--r: 10px;
		--sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--mono: ui-monospace, 'Cascadia Code', 'Cascadia Mono', Consolas, monospace;
		color-scheme: light;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font: 16px/1.6 var(--sans);
		-webkit-font-smoothing: antialiased;
	}
	a {
		color: var(--accent);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	.rail {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 16px;
	}
	.top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 18px;
		padding-bottom: 18px;
	}
	.brand {
		font-weight: 700;
		color: var(--text);
	}
	.brand::before {
		content: '> ';
		color: var(--accent);
		font-family: var(--mono);
	}
	.top nav {
		display: flex;
		gap: 18px;
		font-size: 15px;
	}
	.top nav a {
		color: var(--text2);
	}
	/* 技术标签:首页卡片、技能区、详情页共用 */
	.tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.tags li {
		font: 12.5px/1.5 var(--mono);
		padding: 3px 9px;
		border-radius: 999px;
		background: var(--tag);
		color: var(--tagtext);
	}
	.btn {
		display: inline-block;
		padding: 10px 18px;
		border: 1px solid var(--line2);
		border-radius: var(--r);
		background: var(--card);
		color: var(--text);
		font-weight: 600;
		font-size: 15px;
	}
	.btn:hover {
		text-decoration: none;
		border-color: var(--accent);
	}
	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.foot {
		padding: 20px 0 32px;
		border-top: 1px solid var(--line);
		color: var(--text2);
		font-size: 14px;
	}
</style>
