{{!Page shell with the structure of a Microsoft Learn article page, built from the open-source Atlas Design System (public/atlas.min.css, MIT). Navigation, table of contents, breadcrumbs, "In this article", search and theme are drawn by public/kb.js from DocFX's toc.json and index.json.}}
{{!include(/^public/.*/)}}
{{!include(favicon.ico)}}
{{!include(logo.svg)}}
<!DOCTYPE html>
<html class="layout layout-holy-grail show-table-of-contents conceptual show-breadcrumb default-focus theme-light" lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    {{#redirect_url}}
      <meta http-equiv="refresh" content="0;URL='{{redirect_url}}'">
    {{/redirect_url}}
    {{^redirect_url}}
      <title>{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} {{#_appTitle}}| {{_appTitle}} {{/_appTitle}}</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      {{#description}}<meta name="description" content="{{description}}">{{/description}}
      <link rel="icon" href="{{_rel}}{{{_appFaviconPath}}}{{^_appFaviconPath}}favicon.ico{{/_appFaviconPath}}">
      <link rel="stylesheet" href="{{_rel}}public/atlas.min.css">
      <link rel="stylesheet" href="{{_rel}}public/kb.css">
      <meta name="kb:rel" content="{{_rel}}">
      <meta name="kb:navrel" content="{{_navRel}}">
      <meta name="kb:tocrel" content="{{_tocRel}}">
      <script>
        (function () {
          var t = 'auto'; try { t = localStorage.getItem('kb-theme') || 'auto' } catch (e) {}
          if (t === 'auto') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          document.documentElement.classList.remove('theme-light', 'theme-dark')
          document.documentElement.classList.add('theme-' + t)
        })()
      </script>
      <script type="module" src="{{_rel}}public/kb.js"></script>
    {{/redirect_url}}
  </head>
  {{^redirect_url}}
  <body class="layout-body">
    <header class="layout-body-header background-color-body-medium">
      <a class="visually-hidden-until-focused position-fixed inner-focus" href="#main">Skip to main content</a>
      <div id="kb-primary-nav" class="site-header">
        <button id="kb-menu-button" class="button button-clear inner-focus display-none-tablet" type="button" aria-label="Table of contents" aria-expanded="false">
          <span class="icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M1 3.5h14v1H1zm0 4h14v1H1zm0 4h14v1H1z"/></svg></span>
        </button>
        <a class="site-header-logo" href="{{_rel}}index.html" aria-label="Home">
          <img src="{{_rel}}{{{_appLogoPath}}}{{^_appLogoPath}}logo.svg{{/_appLogoPath}}" alt="" width="24" height="24">
        </a>
        <div class="site-header-divider"></div>
        <a class="site-header-brand" href="{{_rel}}index.html"><span>{{_appName}}</span></a>
        <nav class="site-header-nav display-none display-flex-tablet" aria-label="Global">
          <ul id="kb-nav" class="display-flex"></ul>
        </nav>
        <form id="kb-search" class="kb-search margin-left-auto" role="search" aria-label="Search">
          <button id="kb-search-toggle" class="kb-search-toggle button button-clear inner-focus" type="button" aria-label="Open search">
            <span class="icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M6.5 1a5.5 5.5 0 0 1 4.38 8.83l3.65 3.64-.71.71-3.64-3.65A5.5 5.5 0 1 1 6.5 1zm0 1a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z"/></svg></span>
          </button>
          <span class="kb-search-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M6.5 1a5.5 5.5 0 0 1 4.38 8.83l3.65 3.64-.71.71-3.64-3.65A5.5 5.5 0 1 1 6.5 1zm0 1a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z"/></svg></span>
          <input id="kb-search-input" class="input input-sm" type="search" placeholder="Search" autocomplete="off" aria-label="Search">
          <ul id="kb-search-results" class="kb-search-results" role="listbox" hidden></ul>
        </form>
        <div class="kb-theme position-relative">
          <button class="kb-theme-button button button-clear inner-focus" type="button" aria-label="Change theme" aria-expanded="false">
            <span class="icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1v12A6 6 0 0 1 8 2z"/></svg></span>
          </button>
          <ul class="kb-theme-menu kb-theme-menu-down" hidden>
            <li><button type="button" class="button button-clear button-sm button-block" data-theme="light">Light</button></li>
            <li><button type="button" class="button button-clear button-sm button-block" data-theme="dark">Dark</button></li>
            <li><button type="button" class="button button-clear button-sm button-block" data-theme="auto">Auto</button></li>
          </ul>
        </div>
      </div>
      <div id="kb-secondary-nav" class="display-none display-flex-tablet">
        <div class="site-header width-full">
          <a id="kb-section-brand" class="site-header-brand font-size-h6 padding-inline-none margin-right-xxs" href="{{_rel}}index.html"><span>{{_appName}}</span></a>
          <nav class="site-header-nav width-auto" aria-label="Site">
            <ul id="kb-section-nav" class="display-flex"></ul>
          </nav>
        </div>
      </div>
    </header>

    <section id="layout-body-menu" class="layout-body-menu border-right display-flex background-color-body-medium" aria-label="Table of contents">
      <div id="left-container" class="left-container display-none display-block-tablet padding-none width-full">
        <nav id="affixed-left-container" class="position-sticky display-flex flex-direction-column padding-left-sm padding-bottom-sm" aria-label="Primary">
          <ul id="kb-mobile-nav" class="kb-mobile-nav display-none-tablet" aria-label="Site sections"></ul>
          <div id="kb-toc-header" class="display-flex flex-direction-row-reverse align-items-center">
            <button id="kb-toc-collapse" class="button button-clear button-sm inner-focus" type="button" aria-label="Collapse" aria-expanded="true">
              <span class="icon display-none-layout-menu-collapsed" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M8.35 3.65l.7.7L5.41 8l3.64 3.65-.7.7L4 8zm4 0l.7.7L9.41 8l3.64 3.65-.7.7L8 8z"/></svg></span>
              <span class="icon display-none display-inline-layout-menu-collapsed" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path fill="currentColor" d="M7.65 3.65l-.7.7L10.59 8l-3.64 3.65.7.7L12 8zm-4 0l-.7.7L6.59 8l-3.64 3.65.7.7L8 8z"/></svg></span>
            </button>
          </div>
          <form role="search" aria-label="Find by title" class="kb-filter margin-bottom-xxs display-none-layout-menu-collapsed">
            <span class="kb-filter-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M1 3h14v1H1zm2 4h10v1H3zm2 4h6v1H5z"/></svg></span>
            <input id="kb-toc-filter" class="input input-sm width-full" type="search" placeholder="Find by title" autocomplete="off" aria-label="Find by title">
          </form>
          <ul id="kb-toc" class="tree table-of-contents is-vertically-scrollable flex-grow-1 flex-shrink-1 padding-right-sm display-none-layout-menu-collapsed" role="tree" aria-label="Table of contents"></ul>
        </nav>
      </div>
    </section>

    <main id="main" role="main" class="layout-body-main">
      <div class="reading-width margin-inline-auto layout-padding padding-top-sm padding-bottom-lg">
        <div id="article-header" class="margin-bottom-xs">
          <nav aria-label="Breadcrumb">
            <ol id="kb-breadcrumbs" class="breadcrumbs"></ol>
          </nav>
        </div>
        <article class="content" data-uid="{{uid}}">
          {{!body}}
        </article>
        <nav id="center-doc-outline" class="doc-outline display-none-desktop margin-bottom-sm" aria-label="In this article" hidden>
          <h2 class="title is-6 margin-block-xs">In this article</h2>
          <ol id="kb-center-outline" class="border-left padding-left-xxs"></ol>
        </nav>
        {{#kbDate}}
        <div id="article-metadata-footer" class="page-metadata-container margin-top-lg">
          <ul class="metadata page-metadata">
            <li><span class="badge badge-sm">Last updated on <time datetime="{{kbDateIso}}">{{kbDate}}</time></span></li>
          </ul>
        </div>
        {{/kbDate}}
      </div>
    </main>

    <aside id="layout-body-aside" class="layout-body-aside" aria-label="Additional resources">
      <div class="right-container padding-sm display-none display-block-desktop height-full">
        <div id="affixed-right-container" class="position-sticky">
          <nav id="side-doc-outline" class="doc-outline padding-bottom-xs margin-bottom-xs" aria-label="In this article" hidden>
            <h2 class="title is-6 margin-top-xxs margin-bottom-xs">In this article</h2>
            <ol id="kb-outline" class="padding-right-xxs"></ol>
          </nav>
        </div>
      </div>
    </aside>

    <div class="layout-body-footer">
      <footer id="footer" class="footer-layout padding-xs padding-sm-desktop border-top" role="contentinfo">
        <div class="display-flex flex-wrap-wrap gap-xs align-items-center justify-content-space-between">
          <div class="kb-theme position-relative">
            <button class="kb-theme-button button button-clear button-sm inner-focus" type="button" aria-expanded="false">
              <span class="icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1v12A6 6 0 0 1 8 2z"/></svg></span>
              <span>Theme</span>
            </button>
            <ul class="kb-theme-menu" hidden>
              <li><button type="button" class="button button-clear button-sm button-block" data-theme="light">Light</button></li>
              <li><button type="button" class="button button-clear button-sm button-block" data-theme="dark">Dark</button></li>
              <li><button type="button" class="button button-clear button-sm button-block" data-theme="auto">Auto</button></li>
            </ul>
          </div>
          <div class="font-size-sm">{{{_appFooter}}}</div>
        </div>
      </footer>
    </div>
  </body>
  {{/redirect_url}}
</html>
